{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet list package:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Edit(ClaudeAutomationDemo.Api/Migrations/**)",
      "Read(**/*.db)",
      "Bash(dotnet ef database drop:*)",
      "Bash(dotnet nuget push:*)"
    ],
    "ask": [
      "Bash(dotnet run:*)",
      "Bash(dotnet add package:*)",
      "Bash(git push:*)"
    ]
  }
}
